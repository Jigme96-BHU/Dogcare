---
// Sticky Book Now + call bar, phones and small tablets only.
import Button from './Button.astro';
import Icon from './Icon.astro';
import { business, links } from '../data/site';
---
<div class="mobile-bar">
  <Button href={links.book} size="lg" class="mobile-bar__book">Book Now</Button>
  <a href={business.phoneHref} class="mobile-bar__call" aria-label="Call Completely Dogcare"><Icon name="phone" /></a>
</div>

<style>
  .mobile-bar { display: none; }
  @media (max-width: 899px) {
    .mobile-bar {
      display: flex; gap: var(--s1);
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 20;
      padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
      background: rgba(244, 242, 240, 0.96);
      box-shadow: 0 -6px 16px rgba(46, 58, 59, 0.12);
    }
    .mobile-bar :global(.mobile-bar__book) { flex-grow: 1; }
    .mobile-bar__call {
      width: 56px; height: 56px; flex-shrink: 0;
      border-radius: var(--r-pill); border: 2px solid var(--ink); color: var(--ink);
      display: flex; align-items: center; justify-content: center;
    }
  }
</style>
