---
// Optimised photo: resized, converted to WebP, lazy-loaded.
// `sizes` tells the browser how wide the photo shows so it picks the right file.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  ratio?: string;
  eager?: boolean;
  class?: string;
}
const { src, alt, sizes = '(max-width: 600px) 90vw, 400px', ratio, eager = false, class: className } = Astro.props;
---
<Image
  src={src}
  alt={alt}
  widths={[240, 400, 640, 960].filter((w) => w <= src.width)}
  sizes={sizes}
  format="webp"
  quality={78}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  class={className}
  style={ratio ? `aspect-ratio:${ratio}; object-fit:cover; width:100%; height:auto` : undefined}
/>
