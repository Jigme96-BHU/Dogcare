---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Button from '../components/Button.astro';
import { business, links } from '../data/site';
import { faq } from '../data/faq';

// FAQ markup for Google, so answers can show directly in search results.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Layout title="FAQ | Completely Dogcare" description="Answers to common questions about Completely Dogcare: vaccinations, staff-to-dog ratio, tours, playgroups, what to bring and more.">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <PageHeader title="Got questions?" intro="Everything new families usually ask us. Can’t find your answer? Give us a call." note={{ time: '6pm', label: 'Pick-up' }} />

  <main>
    <section class="section bg-cream">
      <div class="container faq-wrap">
        <div class="faq">
          {faq.map((f, i) => (
            <details open={i === 0}>
              <summary><span class="faq__num">{String(i + 1).padStart(2, '0')}</span>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>

        <div class="card cta-band">
          <h2 class="h3">Still wondering about something?</h2>
          <p>Call <a href={business.phoneHref}>{business.phone}</a> or email <a href={`mailto:${business.email}`}>{business.email}</a>.</p>
          <div class="actions">
            <Button href={links.firstTimers}>First Timers</Button>
            <Button href="/#contact" variant="outline">Send an enquiry</Button>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .faq-wrap { max-width: calc(880px + 2 * var(--gutter)); }
  .faq { display: flex; flex-direction: column; gap: var(--s2); }
  details { background: var(--white); border-radius: 24px; }
  summary {
    display: flex; align-items: center; gap: var(--s2);
    padding: var(--s3); cursor: pointer; list-style: none;
    font-weight: 700; font-size: clamp(17px, 1rem + 0.25vw, 19px); line-height: 1.35;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: '+'; margin-left: auto; flex-shrink: 0;
    width: 36px; height: 36px; border-radius: var(--r-pill); background: var(--pink-tint);
    display: flex; align-items: center; justify-content: center;
    font-size: 24px; font-weight: 500; color: var(--plum); transition: rotate .2s ease;
  }
  details[open] summary::after { rotate: 45deg; }
  .faq__num { font-family: var(--font-hand); font-size: 26px; color: var(--pink); flex-shrink: 0; }
  details p { padding: 0 var(--s3) var(--s3) calc(var(--s3) + 42px); font-size: 17px; line-height: 1.7; }
  @media (max-width: 599px) {
    details p { padding-left: var(--s3); }
  }
</style>
